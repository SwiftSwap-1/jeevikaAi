rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Super Administrator helper rule.
    // The email must be verified (Google sign-in always is) so nobody can claim the admin
    // address by registering it first with an email/password account.
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email == 'ayushgupt640@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.role == 'admin'
      );
    }

    // User profile documents: Beneficiaries can create, update, and read their profile
    match /users/{userId} {
      allow read, write: if true;
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Assessment submissions and user skill analytics
    match /assessments/{assessmentId} {
      allow read, write, create: if true;
      allow delete: if isAdmin();
    }

    // Public Opportunities and Job Directory: Read-only for public, full CRUD for admin
    match /opportunities/{opportunityId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // NSQF Skill Pathways
    match /pathways/{pathwayId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Training Centers and PMKVY / RSETI Providers
    match /training_centers/{centerId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // System Statistics & Location Intelligence
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
